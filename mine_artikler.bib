  keywords        = {Adult; Antibodies, Bacterial, blood; Humans; Incidence; Middle Aged; Retrospective Studies; Salmonella Infections, epidemiology; Salmonella enteritidis, immunology, isolation & purification; Seroepidemiologic Studies},
  nlm-id          = {8703737},
  owner           = {NLM},
  pii             = {S0950268807009314},
  pmc             = {PMC2870874},
  pmid            = {17678562},
